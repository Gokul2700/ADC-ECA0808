
clc;
clear;
close all;

% EXPERIMENT NO. 1
% AM GENERATION AND DETECTION USING AM TRAINER KIT
%
% OBJECTIVE 1: Calculate modulation index
% OBJECTIVE 2: Analyze under-modulation (m < 1)
% OBJECTIVE 3: Determine critical modulation (m = 1)
% OBJECTIVE 4: Evaluate over-modulation (m > 1)

%% 1. SIGNAL PARAMETERS

Am = 1;             % Message amplitude
Ac = 1;             % Carrier amplitude
fm = 5;             % Message frequency (Hz)
fc = 100;           % Carrier frequency (Hz)
fs = 10000;         % Sampling frequency (Hz)

t = 0:1/fs:0.6;

% Modulation indices for three conditions
m_values = [0.5 1.0 1.5];

%% 2. GENERATE MESSAGE AND CARRIER

message = Am*cos(2*pi*fm*t);
carrier = Ac*cos(2*pi*fc*t);

%% 3. PLOT MESSAGE AND CARRIER SIGNALS

figure(1);

subplot(2,1,1);
plot(t,message,'b','LineWidth',1.2);
grid on;
title('Baseband (Message) Signal');
xlabel('Time (s)');
ylabel('Amplitude');

subplot(2,1,2);
plot(t,carrier,'c','LineWidth',1);
grid on;
xlim([0 0.05]);
title('Carrier Signal');
xlabel('Time (s)');
ylabel('Amplitude');

%% 4. GENERATE AM SIGNALS FOR ALL CONDITIONS

for k = 1:3

    m = m_values(k);

    % AM signal
    am_signal = Ac*(1 + m*cos(2*pi*fm*t)) ...
                .* cos(2*pi*fc*t);

    % Theoretical envelopes
    upper = Ac*(1 + m*cos(2*pi*fm*t));
    lower = -upper;

    % Envelope maximum and minimum
    Vmax = Ac*(1 + m);
    Vmin = Ac*(1 - m);

    % Modulation index
    if m <= 1
        MI = (Vmax - Vmin)/(Vmax + Vmin);
    else
        MI = m;
    end

    %% 5. ENVELOPE DETECTION

    rectified = abs(am_signal);

    N = round(fs/fc);
    kernel = ones(1,N)/N;

    detected = conv(rectified,kernel,'same');

    % Remove DC component
    recovered = detected - mean(detected);

    % Normalize recovered signal
    peak = max(abs(recovered));

    if peak > 0
        recovered = recovered/peak;
    end

    %% 6. PLOT AM MODEL GRAPH

    figure(k+1);

    % Baseband signal
    subplot(4,1,1);
    plot(t,message,'b','LineWidth',1.2);
    grid on;
    xlim([0 0.6]);
    title('Baseband Signal');
    xlabel('Time (s)');
    ylabel('Amplitude');

    % Carrier signal
    subplot(4,1,2);
    plot(t,carrier,'c','LineWidth',1);
    grid on;
    xlim([0 0.05]);
    title('Carrier Signal');
    xlabel('Time (s)');
    ylabel('Amplitude');

    % AM waveform and envelopes
    subplot(4,1,3);
    plot(t,am_signal,'b');
    hold on;
    plot(t,upper,'r--','LineWidth',1.2);
    plot(t,lower,'r--','LineWidth',1.2);
    grid on;
    xlim([0 0.6]);
    title(['AM Signal, m = ',num2str(m)]);
    xlabel('Time (s)');
    ylabel('Amplitude');
    legend('AM Signal','Upper Envelope', ...
           'Lower Envelope');

    % Demodulated output
    subplot(4,1,4);
    plot(t,message,'b--','LineWidth',1.2);
    hold on;
    plot(t,recovered,'r','LineWidth',1.2);
    grid on;
    xlim([0 0.6]);
    title('Demodulated Output');
    xlabel('Time (s)');
    ylabel('Amplitude');
    legend('Original Message','Detected Output');

    %% 7. DISPLAY CALCULATIONS

    fprintf('\n----------------------------------\n');

    if m < 1
        fprintf('OBJECTIVE 2: UNDER-MODULATION\n');
    elseif m == 1
        fprintf('OBJECTIVE 3: CRITICAL MODULATION\n');
    else
        fprintf('OBJECTIVE 4: OVER-MODULATION\n');
    end

    fprintf('Maximum envelope = %.2f V\n',Vmax);
    fprintf('Signed minimum envelope = %.2f V\n',Vmin);
    fprintf('Modulation index = %.2f\n',MI);
    fprintf('Percentage modulation = %.0f%%\n',MI*100);

end

%% 8. OBJECTIVE 1: MODULATION INDEX SUMMARY

disp(' ');
disp('OBJECTIVE 1: MODULATION INDEX CALCULATION');
disp('m = (Vmax - Vmin)/(Vmax + Vmin)');
disp('Use measured envelope values for experimental results.');

%% 9. RESULT

disp(' ');
disp('RESULT:');
disp('AM signals generated successfully.');
disp('Under-modulation studied for m < 1.');
disp('Critical modulation studied for m = 1.');
disp('Over-modulation studied for m > 1.');
disp('Envelope detection simulated in MATLAB.');

